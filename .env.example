# PostgreSQL & PostGIS konfigurācija
POSTGRES_DB=kartes
POSTGRES_USER=kartes
POSTGRES_PASSWORD=kartes_secret_password
POSTGRES_PORT=5432

# Martin Tile Server (MVT vektoru flīzes)
MARTIN_PORT=3000

# Go Backend REST API
API_PORT=8080

# Dragonfly / Redis In-Memory Cache
CACHE_PORT=6379

# pgAdmin (izvēles datu bāzes Web GUI)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@kartes.local
PGADMIN_DEFAULT_PASSWORD=admin
